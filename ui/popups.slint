// Small Lasso surfaces outside the frozen screen: the first-time "Closed. Restore" popup (the user, 13 Nov 2026:
// "First time you do it, a popup, next time, a button in the tray icon"), the corner thumbnail after a capture,
// and pinned pictures (float on top, drag to move, wheel = zoom, Ctrl+wheel = see-through, double-click / Esc closes).

import { B, I, Kbd, BarBtn, Ico, Logo } from "bars.slint";

export component RestorePopup inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    in property <string> when;
    callback restore();
    callback dismiss();
    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - 12px;
        border-radius: 12px;
        background: B.bar;
        border-width: 1px;
        border-color: B.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000088;
        HorizontalLayout {
            padding: 12px;
            spacing: 10px;
            Logo { y: (parent.height - self.height) / 2; width: 24px; height: 24px; }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "Closed. Your capture is kept."; color: B.text; font-size: 13.5px; font-weight: 600; }
                Text { text: "Next time it's in the tray menu"; color: B.muted; font-size: 12px; }
            }
            BarBtn {
                y: (parent.height - self.height) / 2;
                icon: I.restore;
                text: "Restore";
                primary: true;
                clicked => { root.restore(); }
            }
            BarBtn {
                y: (parent.height - self.height) / 2;
                icon: I.close;
                muted: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

// The corner thumbnail after a capture (CleanShot's "quick access overlay", the user's list of 20 Nov 2026): drag the
// picture out into Discord / a browser / a folder, click = edit, buttons copy / save / pin / edit / delete / close.
// Stays while the mouse is over it.
export component Thumb inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    in property <image> pic;
    in property <string> info;
    in property <string> note;
    // false = no drag out here (the hint then says click = edit only)
    in property <bool> can-drag: true;
    // the "Delete the last capture" key ("" = none set), shown while the mouse is on the picture
    in property <string> del-key;
    callback open();
    callback act(string);
    callback hover(bool);
    callback drag-out();
    property <bool> dragging;
    outer := TouchArea {
        changed has-hover => { root.hover(self.has-hover); }
        Rectangle {
            x: 6px;
            y: 6px;
            width: root.width - 12px;
            height: root.height - 12px;
            border-radius: 12px;
            background: B.bar;
            border-width: 1px;
            border-color: B.line;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000088;
            clip: true;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Rectangle {
                    border-radius: 8px;
                    clip: true;
                    background: #000;
                    vertical-stretch: 1;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.pic;
                        image-fit: contain;
                    }
                    ta := TouchArea {
                        mouse-cursor: root.dragging ? MouseCursor.grabbing : root.can-drag ? MouseCursor.grab : MouseCursor.pointer;
                        pointer-event(ev) => {
                            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                                root.dragging = false;
                            }
                        }
                        moved => {
                            // a drag of more than 6 px = take the picture out (once per press)
                            if root.can-drag && self.pressed && !root.dragging
                                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                                root.dragging = true;
                                root.drag-out();
                            }
                        }
                        clicked => {
                            if !root.dragging { root.open(); }
                        }
                    }
                    if ta.has-hover && !root.dragging: Rectangle {
                        background: #000000a0;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.can-drag ? "Drag it anywhere" : "Click to edit"; color: white; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                            if root.can-drag: Text { text: "Discord, a browser, a folder · click = edit"; color: #ffffffc0; font-size: 11.5px; horizontal-alignment: center; }
                            if root.del-key != "": Text { text: root.del-key + " deletes it (no mouse needed)"; color: #ffffffc0; font-size: 11.5px; horizontal-alignment: center; }
                        }
                    }
                    // what just happened ("Uploading for a link...", "Link copied - expires in 1 year", "Copied + saved ·
                    // name.png"), the picture's whole width, wrapping (24 Nov 2026: next to the buttons it was cut
                    // off after ~15 letters)
                    if root.note != "": Rectangle {
                        y: parent.height - self.height;
                        height: nt.preferred-height + 10px;
                        background: #000000d0;
                        nt := Text {
                            x: 8px;
                            y: 5px;
                            width: parent.width - 16px;
                            text: root.note;
                            color: white;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 2px;
                    Text { text: root.info; color: B.muted; font-size: 11.5px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    BarBtn { icon: I.copy; clicked => { root.act("copy"); } }
                    BarBtn { icon: I.save; clicked => { root.act("save"); } }
                    BarBtn { icon: I.pin; clicked => { root.act("pin"); } }
                    BarBtn { icon: I.edit; clicked => { root.open(); } }
                    BarBtn { icon: I.trash; clicked => { root.act("delete"); } }
                    BarBtn { icon: I.close; muted: true; clicked => { root.act("close"); } }
                }
            }
        }
    }
}

export component Pin inherits Window {
    no-frame: true;
    title: "Lasso pin";
    background: transparent;
    in property <image> pic;
    in property <float> see: 1.0;
    in property <string> zoom-text;
    callback drag-start(length, length);
    callback drag(length, length);
    callback wheel(float, bool);
    callback close-pin();
    Rectangle {
        x: 4px;
        y: 4px;
        width: root.width - 8px;
        height: root.height - 8px;
        opacity: root.see;
        border-width: 1px;
        border-color: B.accent;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000088;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.pic;
            image-fit: fill;
        }
    }
    ta := TouchArea {
        mouse-cursor: move;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.drag-start(self.mouse-x, self.mouse-y);
            } else if e.kind == PointerEventKind.move && self.pressed {
                root.drag(self.mouse-x, self.mouse-y);
            }
        }
        double-clicked => { root.close-pin(); }
        scroll-event(e) => {
            root.wheel(e.delta-y > 0 ? 1 : -1, e.modifiers.control);
            accept
        }
    }
    if ta.has-hover && root.zoom-text != "": Rectangle {
        x: root.width - self.width - 10px;
        y: 10px;
        width: zt.preferred-width + 12px;
        height: 20px;
        border-radius: 5px;
        background: #000000aa;
        zt := Text { text: root.zoom-text; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// First start ever: where Lasso lives + the two ways to start it
export component Hello inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    callback act(string);
    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - 12px;
        border-radius: 12px;
        background: B.bar;
        border-width: 1px;
        border-color: B.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000088;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Logo { width: 26px; height: 26px; }
                Text { text: "Lasso is running"; color: B.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                BarBtn { icon: I.close; muted: true; clicked => { root.act("ok"); } }
            }
            Text {
                text: "It waits in the tray. Click its icon (or run lasso --region) to freeze the screen, drag a box, draw, press Enter. Esc closes at once - nothing is lost.";
                color: B.muted;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                BarBtn { text: "Set up a key"; clicked => { root.act("keys"); } }
                BarBtn { icon: I.crop; text: "Capture now"; primary: true; clicked => { root.act("capture"); } }
            }
        }
    }
}

// Scrolling capture: what's happening + Done / Cancel (the page under the box is scrolled by the user)
export component ScrollPopup inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    in property <string> status;
    callback act(string);
    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - 12px;
        border-radius: 12px;
        background: B.bar;
        border-width: 1px;
        border-color: B.accent;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000088;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Logo { width: 22px; height: 22px; }
                Text { text: "Scrolling capture"; color: B.text; font-size: 14.5px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Text { text: root.status; color: B.muted; font-size: 12.5px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                BarBtn { text: "Cancel"; clicked => { root.act("cancel"); } }
                BarBtn { icon: I.check; text: "Done"; primary: true; clicked => { root.act("done"); } }
            }
        }
    }
}

// The tray flyout (the user, 26 Nov 2026: "make Lasso more of a mini bar extension, at least the library part"): a
// left-click on the tray icon opens it right above the tray. Capture buttons on top, the latest captures in their own
// shape (rows that fill the width, worked out in Rust: app.rs flyout_rows), click = copy, drag = take it out, and the
// full Library / Settings one click away. Esc or a click anywhere else closes it.
export struct FlyPic {
    img: image,
    x: length,
    y: length,
    w: length,
    h: length,
    ago: string,
}

// one line of the flyout for what the old tray menu had (Restore last capture, pins, an update)
component FlyRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> accent;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: root.accent ? (rta.has-hover ? B.accent.with-alpha(0.32) : B.accent.with-alpha(0.2)) : rta.has-hover ? B.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        Ico { y: (parent.height - self.height) / 2; commands: root.icon; stroke: root.accent ? B.accent : B.muted; }
        Text { text: root.text; color: root.accent ? B.accent : B.text; font-size: 13px; font-weight: root.accent ? 600 : 400; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    rta := TouchArea { clicked => { root.clicked(); } }
}

export component Flyout inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    in property <[FlyPic]> pics;
    // height of all the picture rows (the list scrolls when it's more than the room it gets)
    in property <length> grid-h;
    // the "capture an area" hotkey to show on the button ("" = none)
    in property <string> cap-key;
    // the picture that was just copied (-1 = none) + a short note ("Copied", "Dropped", an error)
    in property <int> flash: -1;
    in property <string> flash-text;
    in property <bool> can-drag: true;
    // the Capture area button's background (painted in Rust: gradient + round corners)
    in property <image> cap-bg;
    // the old tray menu's "Update to Lasso X" ("" = none out)
    in property <string> update-label;
    in property <string> restore-label;
    in property <bool> pins-through;
    callback act(string);
    callback pick(int);
    callback drag-out(int);
    property <bool> dragging;
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.act("close"); return accept; }
            reject
        }
    }
    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - 12px;
        border-radius: 14px;
        background: B.bar;
        border-width: 1px;
        border-color: B.line;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000090;
        clip: true;
        VerticalLayout {
            // title row: logo, name, Library + Settings
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                padding-top: 10px;
                padding-bottom: 8px;
                spacing: 8px;
                height: 50px;
                Logo { y: (parent.height - self.height) / 2; width: 22px; height: 22px; }
                Text { text: "Lasso"; color: B.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            // capture: a big "area" button, then full screen and a window
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                height: 48px;
                // the bars' primary gradient (BarBtn), in a button that fills the row. The software renderer draws a
                // gradient with square corners (a rounded clip doesn't help either), so Rust paints it - round corners
                // included - into `cap-bg` (app.rs rounded_gradient, 26 Nov 2026)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    Image { width: parent.width; height: parent.height; source: root.cap-bg; image-fit: fill; }
                    if cta.has-hover: Image { width: parent.width; height: parent.height; source: root.cap-bg; image-fit: fill; opacity: 0.35; colorize: white; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Ico { y: (parent.height - self.height) / 2; commands: I.area; stroke: B.on-accent; }
                        Text { text: "Capture area"; color: B.on-accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    }
                    cta := TouchArea { mouse-cursor: pointer; clicked => { root.act("region"); } }
                }
                Rectangle {
                    // fixed: Capture area's painted background is made for the width that's left (app.rs)
                    width: 100px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: B.line;
                    BarBtn { width: parent.width; height: 36px; border-radius: 9px; icon: I.monitor; text: "Screen"; clicked => { root.act("full"); } }
                }
                Rectangle {
                    // fixed: Capture area's painted background is made for the width that's left (app.rs)
                    width: 100px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: B.line;
                    BarBtn { width: parent.width; height: 36px; border-radius: 9px; icon: I.window; text: "Window"; clicked => { root.act("window"); } }
                }
            }
            if root.update-label != "" || root.restore-label != "" || root.pins-through: VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 6px;
                if root.update-label != "": FlyRow { icon: I.update; text: root.update-label; accent: true; clicked => { root.act("update"); } }
                if root.restore-label != "": FlyRow { icon: I.restore; text: root.restore-label; clicked => { root.act("restore"); } }
                if root.pins-through: FlyRow { icon: I.pin; text: "Make pins clickable again"; clicked => { root.act("pins-clickable"); } }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                height: 24px;
                Text { text: "RECENT"; color: B.dim; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; vertical-alignment: center; horizontal-stretch: 1; }
                if root.pics.length > 0: Text { text: root.can-drag ? "click to copy · drag out" : "click to copy"; color: B.dim; font-size: 11px; vertical-alignment: center; }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.pics.length == 0: Text {
                    text: "Nothing here yet - your captures show up here.";
                    color: B.muted;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Flickable {
                    x: 12px;
                    width: parent.width - 24px;
                    content-height: root.grid-h;
                    for p[i] in root.pics: Rectangle {
                        x: p.x;
                        y: p.y;
                        width: p.w;
                        height: p.h;
                        border-radius: 7px;
                        clip: true;
                        background: B.panel2;
                        Image { width: parent.width; height: parent.height; source: p.img; image-fit: cover; }
                        Rectangle { border-radius: 7px; border-width: 1px; border-color: B.line; }
                        pta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            pointer-event(ev) => {
                                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { root.dragging = false; }
                            }
                            moved => {
                                if root.can-drag && self.pressed && !root.dragging
                                    && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                                    root.dragging = true;
                                    root.drag-out(i);
                                }
                            }
                            clicked => { if !root.dragging { root.pick(i); } }
                        }
                        if pta.has-hover && root.flash != i: Rectangle {
                            border-radius: 7px;
                            border-width: 2px;
                            border-color: B.accent;
                            Rectangle {
                                x: 5px;
                                y: parent.height - self.height - 5px;
                                width: at.preferred-width + 10px;
                                height: 18px;
                                border-radius: 5px;
                                background: #000000a8;
                                at := Text { text: p.ago; color: white; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.flash == i: Rectangle {
                            background: B.accent.with-alpha(0.82);
                            Text { text: root.flash-text; color: white; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; width: parent.width - 8px; }
                        }
                    }
                }
            }
            Rectangle { height: 8px; }
            // Library + Settings (only here - 26 Nov 2026, not twice)
            Rectangle {
                height: 1px;
                background: B.line;
            }
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                height: 56px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: B.line;
                    BarBtn { width: parent.width; height: parent.height; border-radius: 9px; icon: I.library; text: "Open Library"; clicked => { root.act("library"); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: B.line;
                    BarBtn { width: parent.width; height: parent.height; border-radius: 9px; icon: I.gear; text: "Settings"; clicked => { root.act("settings"); } }
                }
            }
        }
    }
}

// Behind the tray flyout on every monitor (Linux): see-through, catches the click outside it, which closes it
export component FlyCatch inherits Window {
    no-frame: true;
    title: "Lasso";
    background: transparent;
    callback clicked();
    TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.clicked(); }
        }
    }
}
