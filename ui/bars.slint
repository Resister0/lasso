export component Ico inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    width: 17px;
    height: 17px;
}

// the logo in the theme's colours (24 Nov 2026, like LogoMark in theme.slint): gradient tile + the lasso on top
export component Logo inherits Rectangle {
    width: 20px;
    height: 20px;
    border-radius: self.width * 14 / 64;
    background: @linear-gradient(135deg, B.g0 0%, B.accent 55%, B.accent3 100%);
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/icons/lasso-mark.svg");
        colorize: B.on-accent;
    }
}

export component Kbd inherits Rectangle {
    in property <string> text;
    in property <bool> on-accent;
    // the chip is centred in whatever height the layout gives
    width: kt.preferred-width + 10px;
    min-height: 18px;
    Rectangle {
        y: (parent.height - 18px) / 2;
        height: 18px;
        border-radius: 4px;
        background: root.on-accent ? #ffffff30 : B.panel2;
        border-width: 1px;
        border-color: root.on-accent ? #ffffff40 : B.line;
        Rectangle {
            y: parent.height - 2px;
            height: 1px;
            background: root.on-accent ? #ffffff40 : B.line;
        }
        kt := Text {
            text: root.text;
            font-size: 10.5px;
            font-weight: 500;
            color: root.on-accent ? white : B.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component BarBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> kbd;
    in property <string> kbd-plain;
    in property <bool> primary;
    in property <bool> on;
    in property <bool> muted;
    in property <bool> dim;
    in property <bool> icon-accent;
    callback clicked;
    height: 30px;
    width: max(30px, hl.preferred-width);
    border-radius: 7px;
    background: root.primary ? @linear-gradient(135deg, B.accent2 0%, B.accent 55%, B.accent3 100%)
        : root.on ? B.accent.with-alpha(0.22) : ta.has-hover ? B.hover : transparent;
    opacity: root.dim ? 0.45 : 1;
    property <color> fg: root.primary ? white : root.on ? B.accent : root.muted ? B.muted : B.text;
    hl := HorizontalLayout {
        padding-left: root.text == "" && root.kbd-plain == "" ? 6px : root.primary ? 12px : 8px;
        padding-right: root.text == "" && root.kbd-plain == "" ? 6px : root.primary ? 12px : 8px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Ico {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            stroke: root.icon-accent ? B.accent : root.fg;
        }
        if root.kbd != "": Kbd { y: (parent.height - self.height) / 2; text: root.kbd; }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
        if root.kbd-plain != "": Text {
            text: root.kbd-plain;
            color: root.primary ? #ffffffb8 : B.dim;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Sw inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: shl.preferred-width;
    shl := HorizontalLayout {
        spacing: 6px;
        Rectangle {
            y: (parent.height - 16px) / 2;
            width: 28px;
            height: 16px;
            border-radius: 8px;
            background: root.on ? B.accent : B.line;
            Rectangle {
                x: root.on ? 14px : 2px;
                y: 2px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: white;
            }
        }
        Text {
            text: root.text;
            color: B.muted;
            font-size: 12.5px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}
