// The floating bars' look (overlay.html): Aimdot's dark panels, or light ones ("follow system" on a light
// desktop), 10 px corners, Lasso teal for the box, the picked tool and the Share button.

export global B {
    in-out property <bool> dark: true;
    out property <color> bar: dark ? #16161af5 : #fffffff5;
    out property <color> panel2: dark ? #1e1e23 : #f0f0ed;
    out property <color> line: dark ? #2c2c33 : #dcdcd6;
    out property <color> hover: dark ? #2c2c33 : #ececE8;
    out property <color> text: dark ? #f5f5f7 : #111317;
    out property <color> muted: dark ? #a0a0ab : #5d636b;
    out property <color> dim: dark ? #6b6b76 : #9aa0a8;
    in-out property <color> accent: #14a38b;
    in-out property <color> accent2: #36c9a8;
    in-out property <color> accent3: #0d8085;
    // the logo tile: the theme's gradient start (accent / accent3 are its middle / end) and the lasso on it
    // (near-black on very light accents: Mono, Sand...)
    in-out property <color> g0: #36c9a8;
    in-out property <color> on-accent: #ffffff;
}

