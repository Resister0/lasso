// Settings - "a decent bit of customizability" (the user, 13 Nov 2026), in a mini Aimdot window.
// Every change is written to config.ini at once and the running Lasso is told to reload (windows_ui.rs).

import { T, Ic, Icon, Find, Btn, Switch, Slider, Opt, Seg, NavBtn, Card, Row, Note, Kbd, ThemeGrid, ThemeCard, LogoMark } from "theme.slint";
import { TitleBar, Edges } from "winframe.slint";
import { ScrollView } from "std-widgets.slint";

export struct KeyBind {
    id: string,
    name: string,
    keys: string,
    clash: bool,
}

export struct HkRow {
    id: string,
    name: string,
    key: string,
    kde: string,
}

export struct ToolToggle {
    id: string,
    name: string,
    on: bool,
}

component ChipIcon inherits Rectangle {
    in property <string> text;
    in property <bool> dim;
    callback clicked;
    width: 26px;
    border-radius: 5px;
    background: ita.has-hover && !root.dim ? T.hover : transparent;
    Text { text: root.text; color: root.dim ? T.dim : T.text; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
    ita := TouchArea { enabled: !root.dim; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// one colour dot of the custom theme (the string is the colour, so it can be saved as it is)
component Swatch inherits Rectangle {
    in property <string> hexv;
    in property <bool> on;
    callback picked;
    width: 26px;
    Rectangle {
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.hexv == "#14a38b" ? #14a38b : root.hexv == "#7c5cff" ? #7c5cff : root.hexv == "#2fa8e0" ? #2fa8e0
            : root.hexv == "#2fbf86" ? #2fbf86 : root.hexv == "#e03232" ? #e03232 : root.hexv == "#e0609e" ? #e0609e
            : root.hexv == "#e0a93a" ? #e0a93a : root.hexv == "#8fcf3c" ? #8fcf3c : root.hexv == "#8a96a8" ? #8a96a8
            : root.hexv == "#ef6a4c" ? #ef6a4c : root.hexv == "#0d0d10" ? #0d0d10 : root.hexv == "#0b0e12" ? #0b0e12
            : root.hexv == "#100d0b" ? #100d0b : root.hexv == "#0b100e" ? #0b100e : root.hexv == "#100c0f" ? #100c0f
            : root.hexv == "#08080f" ? #08080f : root.hexv == "#0d1015" ? #0d1015 : root.hexv == "#1a1a1f" ? #1a1a1f
            : root.hexv == "#f4f4f7" ? #f4f4f7 : #f6f2ea;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? T.text : T.line;
    }
    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.picked(); } }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 4px;
    padding-bottom: 6px;
    Text { text: root.title; font-size: 24px; font-weight: 700; color: T.text; }
    Text { text: root.sub; font-size: 13px; color: T.muted; }
}

// Chips in rows (Slint has no wrapping layout): the bar's buttons with ‹ › × (on = true), or "+ name" to add one
component ChipFlow inherits Rectangle {
    in property <[ToolToggle]> items;
    in property <bool> on;
    callback act(string);
    property <length> cw: root.on ? 196px : 176px;
    property <length> gap: 6px;
    property <int> cols: max(1, floor((root.width + root.gap) / (root.cw + root.gap)));
    height: root.items.length == 0 ? 0px : ceil(root.items.length / root.cols) * (30px + root.gap) - root.gap;
    for c[i] in root.items: Rectangle {
        x: mod(i, root.cols) * (root.cw + root.gap);
        y: floor(i / root.cols) * (30px + root.gap);
        width: root.cw;
        height: 30px;
        border-radius: 7px;
        background: root.on ? T.accent.with-alpha(0.16) : add-ta.has-hover ? T.panel2 : T.panel;
        border-width: 1px;
        border-color: root.on ? T.accent.with-alpha(0.5) : add-ta.has-hover ? T.hover : T.line;
        add-ta := TouchArea { enabled: !root.on; mouse-cursor: pointer; clicked => { root.act("add:" + c.id); } }
        HorizontalLayout {
            padding-left: root.on ? 2px : 10px;
            padding-right: 2px;
            spacing: 0;
            if root.on: ChipIcon { text: "‹"; dim: i == 0; clicked => { root.act("left:" + c.id); } }
            Text {
                text: root.on ? c.name : "+  " + c.name;
                color: root.on ? T.text : T.muted;
                font-size: 12.5px;
                vertical-alignment: center;
                horizontal-alignment: root.on ? center : left;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.on: ChipIcon { text: "›"; dim: i == root.items.length - 1; clicked => { root.act("right:" + c.id); } }
            if root.on: ChipIcon { text: "×"; clicked => { root.act("remove:" + c.id); } }
        }
    }
}


component KeyChip inherits Rectangle {
    in property <string> text;
    in property <bool> listening;
    in property <bool> bad;
    callback clicked;
    height: 32px;
    width: max(90px, kt.preferred-width + 24px);
    border-radius: T.r-btn;
    background: root.listening ? T.accent.with-alpha(0.16) : ta.has-hover ? T.panel2 : T.bg;
    border-width: 1px;
    border-color: root.listening ? T.accent : root.bad ? T.bad : ta.has-hover ? T.hover : T.line;
    kt := Text {
        text: root.listening ? "Press a key..." : root.text == "" ? "No key" : root.text;
        font-size: 12.5px;
        font-weight: 500;
        color: root.listening ? T.accent2 : root.text == "" ? T.dim : T.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Settings' state (21 Nov 2026: Settings + Library are one window now, ui/lasso_window.slint; Rust sets these through the global)
export global SS {
    // the section to scroll to (Aimdot-style page, 21 Nov 2026): capture keys hotkeys done library share appearance start about
    in-out property <string> sec;
    in-out property <string> version;
    // Windows: no KDE / Plasma / Spectacle texts (the user, 24 Nov 2026)
    in-out property <bool> win;
    // General
    in-out property <int> enter-does;
    in-out property <bool> always-copy;
    in-out property <string> save-dir;
    in-out property <string> name-pattern;
    in-out property <string> name-example;
    in-out property <int> format;
    in-out property <bool> fits-discord;
    // "Also show in Echo": the switch, and Echo's Screenshots folder ("" = Echo isn't on this PC: no row)
    in-out property <bool> echo-shots;
    in-out property <string> echo-dir;
    in-out property <[ThemeCard]> theme-cards;
    in-out property <string> theme-id;
    in-out property <string> ui-accent;
    in-out property <string> ui-bg;
    in-out property <bool> autostart;
    in-out property <bool> sounds;
    // game screenshots in the Library (26 Nov 2026): Steam's switch + where Steam is, the added folders
    in-out property <bool> steam-shots;
    in-out property <string> steam-note;
    in-out property <[string]> game-dirs;
    // share links
    in-out property <string> share-email;
    // what's typed in the sign-in box (email, then the code); emptied when the code is sent
    in-out property <string> share-input;
    in-out property <bool> share-code-step;
    in-out property <string> share-msg;
    in-out property <bool> share-busy;
    in-out property <bool> share-check;
    in-out property <bool> share-both;
    in-out property <bool> share-once;
    // Capture
    in-out property <int> delay;
    in-out property <bool> pointer;
    in-out property <int> full-mode;
    in-out property <bool> thumb-after-full;
    in-out property <bool> remember-tool;
    in-out property <bool> magnifier;
    // Capture > "Buttons under the box": on the bar (in order) / every other action
    in-out property <[ToolToggle]> bar-on;
    in-out property <[ToolToggle]> bar-off;
    in-out property <bool> usage-ping;
    // About > Updates (src/update.rs): a newer Lasso is known, status line, "Update now" / "Download" / "Updating…"
    in-out property <bool> upd-available;
    in-out property <string> upd-version;
    in-out property <string> upd-notes;
    in-out property <string> upd-status;
    in-out property <string> upd-button: "Update now";
    in-out property <bool> upd-busy;
    in-out property <bool> upd-can-check;
    // update channel (21 Nov 2026, Echo's / Aimdot's): 0 Stable, 1 Beta, 2 Dev; dev asks for the tester code first
    // (SS.act "upd-channel:<n>" / "upd-code:<code>")
    in-out property <int> upd-channel;
    in-out property <bool> upd-asking-code;
    in-out property <bool> upd-code-busy;
    in-out property <string> upd-code-msg;
    in-out property <bool> edits-as-copy;
    // Keys
    in-out property <[KeyBind]> binds;
    in-out property <string> listening;
    in-out property <string> clash-text;
    // Hotkeys
    in-out property <bool> hotkeys-on;
    in-out property <[HkRow]> hotkeys;
    in-out property <string> hk-note;
    // Library
    in-out property <float> keep-count;
    in-out property <int> library-keep;
    in-out property <float> keep-days;
    in-out property <int> link-expiry;
    in-out property <bool> share-on;
    in-out property <[ToolToggle]> tool-toggles;
    in-out property <string> folder-note;

    callback set(string, string);
    callback act(string);
    callback listen(string);
    callback key-captured(string, bool, bool, bool) -> bool;

}

export component SettingsView inherits Rectangle {
    forward-focus: keys-fs;
    // Aimdot's / Echo's settings (21 Nov 2026: "I like the layout of Aimdot's menus - you scroll and it goes through the
    // sections"): one long page, a section list that follows the scroll, a search (Ctrl+F). SS.sec = the section to
    // show when the window opens.
    property <string> active: -sv.content-y + 80px >= about-s.y ? "about" : -sv.content-y + 80px >= updates-s.y ? "updates" : -sv.content-y + 80px >= start-s.y ? "start" : -sv.content-y + 80px >= appearance-s.y ? "appearance" : -sv.content-y + 80px >= share-s.y ? "share" : -sv.content-y + 80px >= library-s.y ? "library" : -sv.content-y + 80px >= done-s.y ? "done" : -sv.content-y + 80px >= hotkeys-s.y ? "hotkeys" : -sv.content-y + 80px >= keys-s.y ? "keys" : "capture";
    function go(id: string) {
        SS.sec = id;
        sv.content-y = -min(max(0px, body.preferred-height - sv.visible-height), id == "keys" ? keys-s.y : id == "hotkeys" ? hotkeys-s.y : id == "done" ? done-s.y : id == "library" ? library-s.y : id == "share" ? share-s.y : id == "appearance" ? appearance-s.y : id == "start" ? start-s.y : id == "updates" ? updates-s.y : id == "about" ? about-s.y : 0px);
    }
    init => {
        if (SS.sec == "") {
            SS.sec = "capture";
        }
        start-timer.running = true;
    }
    // after the first layout: scroll to SS.sec
    start-timer := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            self.running = false;
            root.go(SS.sec);
        }
    }
    property <string> want: SS.sec;
    changed want => { root.go(SS.sec); }
    keys-fs := FocusScope {
        key-pressed(e) => {
            if SS.listening != "" {
                if SS.key-captured(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                    return accept;
                }
            }
            // Ctrl+F = search
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) {
                sq.focus();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        // the section list
        Rectangle {
            width: 200px;
            Rectangle { x: parent.width - 1px; width: 1px; background: T.line; }
            VerticalLayout {
                padding-top: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: sq.has-focus ? T.accent : T.line;
                    background: T.panel2;
                    Icon { x: 10px; width: 14px; height: 14px; commands: Ic.search; stroke: T.dim; }
                    if sq.text == "": Text { x: 31px; text: "Search…  (Ctrl+F)"; font-size: 13px; color: T.muted.with-alpha(0.75); vertical-alignment: center; }
                    sq := TextInput {
                        x: 31px;
                        width: parent.width - 40px;
                        text <=> Find.q;
                        font-size: 13px;
                        color: T.text;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { sv.content-y = 0; }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                self.text = "";
                                keys-fs.focus();
                                return accept;
                            }
                            reject
                        }
                    }
                }
                Rectangle { height: 4px; }
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { text: "CAPTURE"; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; color: T.dim; height: 26px; vertical-alignment: bottom; }
                    }
                    NavBtn { label: "Capture"; icon: "M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0z"; on: Find.q == "" && root.active == "capture"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("capture"); } }
                    NavBtn { label: "Editor keys"; icon: Ic.keys; on: Find.q == "" && root.active == "keys"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("keys"); } }
                    NavBtn { label: "Global hotkeys"; icon: "M13 3L5 13.5h6L10 21l8-10.5h-6z"; on: Find.q == "" && root.active == "hotkeys"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("hotkeys"); } }
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { text: "YOUR PICTURES"; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; color: T.dim; height: 26px; vertical-alignment: bottom; }
                    }
                    NavBtn { label: "Saving & copying"; icon: "M12 3v12M7 10l5 5l5-5M4 21h16"; on: Find.q == "" && root.active == "done"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("done"); } }
                    NavBtn { label: "Library"; icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"; on: Find.q == "" && root.active == "library"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("library"); } }
                    NavBtn { label: "Share links"; icon: "M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"; on: Find.q == "" && root.active == "share"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("share"); } }
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { text: "APP"; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; color: T.dim; height: 26px; vertical-alignment: bottom; }
                    }
                    NavBtn { label: "Appearance"; icon: Ic.palette; on: Find.q == "" && root.active == "appearance"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("appearance"); } }
                    NavBtn { label: "Start"; icon: Ic.power; on: Find.q == "" && root.active == "start"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("start"); } }
                    NavBtn { label: SS.upd-available ? "Updates  •  new" : "Updates"; icon: Ic.reset; on: Find.q == "" && root.active == "updates"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("updates"); } }
                    NavBtn { label: "About"; icon: Ic.info; on: Find.q == "" && root.active == "about"; faded: Find.q != ""; clicked => { Find.q = ""; root.go("about"); } }
                Rectangle { }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            sv := ScrollView {
                body := VerticalLayout {
                    alignment: start;
                    padding: 26px;
                    padding-right: 22px;
                    spacing: 10px;
                    if Find.q != "": PageTitle { title: "Search"; sub: "Settings that match \"" + Find.q + "\""; }
                    capture-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "capture timer delay pointer mouse full screenshot monitor all magnifier zoom buttons bar under the box pin save copy link done thumbnail corner editing last tool start select saved picture replace copy tools you see hide strip order toolbar"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Capture"; sub: "Taking the picture and drawing on it."; }
                            Card {
                            title: "Taking the picture";
                            Row {
                                label: "Timer";
                                sub: "wait before the screen freezes (the Timer button on the frozen screen changes it too)";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "Off", value: 0 }, { label: "3 s", value: 3 }, { label: "5 s", value: 5 }, { label: "10 s", value: 10 }];
                                    value: SS.delay;
                                    picked(v) => { SS.set("delay", v); }
                                }
                            }
                            Row {
                                label: "Include the mouse pointer";
                                Switch { y: (parent.height - self.height) / 2; on: SS.pointer; toggled(v) => { SS.set("pointer", v ? "1" : "0"); } }
                            }
                            Row {
                                label: "Full screenshot takes";
                                sub: "the full-screenshot key: copied + saved at once, no frozen screen";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "Monitor in use", value: 0 }, { label: "All", value: 1 }, { label: "Left", value: 2 }, { label: "2nd", value: 3 }, { label: "3rd", value: 4 }];
                                    value: SS.full-mode;
                                    picked(v) => { SS.set("full_mode", v == 1 ? "all" : v >= 2 ? v - 1 : "mouse"); }
                                }
                            }
                            Row {
                                label: "Magnifier while picking";
                                sub: "a zoomed view of the pixels next to the mouse, for exact boxes";
                                Switch { y: (parent.height - self.height) / 2; on: SS.magnifier; toggled(v) => { SS.set("magnifier", v ? "1" : "0"); } }
                            }
                            Row {
                                label: "Buttons under the box";
                                sub: "any action can be a button: ‹ › moves it, × takes it off, + adds one. Every key works either way";
                            }
                            ChipFlow { items: SS.bar-on; on: true; act(a) => { SS.act("bar:" + a); } }
                            if SS.bar-off.length > 0: Text { text: "Add"; color: T.muted; font-size: 12px; }
                            ChipFlow { items: SS.bar-off; on: false; act(a) => { SS.act("bar:" + a); } }
                            Rectangle { height: 4px; }
                            Row {
                                label: "Corner thumbnail after a capture";
                                sub: "drag it into Discord, a browser or a folder; click it to mark the picture up";
                                Switch { y: (parent.height - self.height) / 2; on: SS.thumb-after-full; toggled(v) => { SS.set("thumb_after_full", v ? "1" : "0"); } }
                            }
                        }
Card {
                            title: "Editing";
                            Row {
                                label: "Start with the last tool you used";
                                sub: "off = a new box starts with Select: dragging inside moves the box";
                                Switch { y: (parent.height - self.height) / 2; on: SS.remember-tool; toggled(v) => { SS.set("remember_tool", v ? "1" : "0"); } }
                            }
                            Row {
                                label: "Editing a saved picture again";
                                sub: "the untouched original always stays in the library (\"Back to original\")";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "Replace the file", value: 0 }, { label: "Save a new copy", value: 1 }];
                                    value: SS.edits-as-copy ? 1 : 0;
                                    picked(v) => { SS.set("edits_as_copy", v); }
                                }
                            }
                        }
Card {
                            title: "Tools on the frozen screen";
                            HorizontalLayout {
                                Note { text: "Switch tools off to hide them (their keys still work); the arrows change the strip's order."; horizontal-stretch: 1; }
                                Btn { small: true; text: "Default order"; clicked => { SS.act("tool-order-reset"); } }
                            }
                            for t[i] in SS.tool-toggles: Row {
                                label: t.name;
                                Btn { y: (parent.height - self.height) / 2; small: true; icon: "M6 15l6-6l6 6"; enabled: i > 0; clicked => { SS.act("tool-up:" + t.id); } }
                                Btn { y: (parent.height - self.height) / 2; small: true; icon: "M6 9l6 6l6-6"; enabled: i < SS.tool-toggles.length - 1; clicked => { SS.act("tool-down:" + t.id); } }
                                Switch { y: (parent.height - self.height) / 2; on: t.on; toggled(v) => { SS.set("tool." + t.id, v ? "1" : "0"); } }
                            }
                        }
                    }
                    keys-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "keys keyboard shortcut shortcuts editor frozen screen reset default change tool undo redo copy save"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Editor keys"; sub: "Keys on the frozen screen - every one can be changed."; }
                            HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }
                            Btn { small: true; text: "Reset all to default"; clicked => { SS.act("reset-keys"); } }
                        }
Note { text: "Click a key to change it, then press the new one. Esc or Backspace removes it. Ctrl+letter keys work on every keyboard layout."; }
if SS.clash-text != "": Text { text: SS.clash-text; color: T.warn; font-size: 13px; wrap: word-wrap; }
Card {
                            for b in SS.binds: Row {
                                label: b.name;
                                KeyChip {
                                    y: (parent.height - self.height) / 2;
                                    text: b.keys;
                                    bad: b.clash;
                                    listening: SS.listening == b.id;
                                    clicked => {
                                        SS.listen(b.id);
                                        keys-fs.focus();
                                    }
                                }
                            }
                        }
                        }
                    }
                    hotkeys-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "global hotkeys hotkey keys print screen capture area full window repeat restore delete last kde shortcuts"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Global hotkeys"; sub: "Keys that work anywhere, even in a game."; }
                            Card {
                            title: "Use global hotkeys";
                            has-switch: true;
                            on: SS.hotkeys-on;
                            toggled(v) => { SS.set("hotkeys", v ? "1" : "0"); }
                            Note {
                                text: SS.win ? "Off until you turn it on. Without hotkeys: click the tray icon, then Capture area."
                                    : "Off until you turn it on. On KDE, Plasma asks once and then owns the keys: change them later in System Settings > Shortcuts > Lasso. Without hotkeys: click the tray icon, then Capture area - or bind \"lasso --region\" in your desktop's shortcut settings.";
                            }
                            Row {
                                label: "Want the Print key?";
                                sub: SS.win ? "Windows opens Snipping Tool with it - turn that off first, then set it here"
                                    : "it belongs to Spectacle on KDE - free it there first, then set it here";
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Open the system's shortcut settings"; clicked => { SS.act("system-keys"); } }
                            }
                            if SS.hk-note != "": Text { text: SS.hk-note; color: T.muted; font-size: 12.5px; wrap: word-wrap; }
                            for h in SS.hotkeys: Row {
                                label: h.name;
                                // KDE (26 Nov 2026): Plasma owns the key once it's set - show the one it really uses, a click
                                // opens KDE's shortcut settings (before, the chip showed Lasso's default next to "KDE uses: ...")
                                sub: !SS.win && h.kde != "" ? "set in KDE - click it to change it there" : "";
                                KeyChip {
                                    y: (parent.height - self.height) / 2;
                                    text: !SS.win && h.kde != "" ? h.kde : h.key;
                                    listening: SS.listening == "hk." + h.id;
                                    clicked => {
                                        if (!SS.win && h.kde != "") {
                                            SS.act("system-keys");
                                        } else {
                                            SS.listen("hk." + h.id);
                                            keys-fs.focus();
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }
                    done-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "saving copying finishing enter done copy save link always copy fits discord 10 mb file too large sounds sound camera shutter click chime save folder file name pattern format png jpg jpeg webp echo screenshots"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Saving & copying"; sub: "What Enter does, where pictures go and what they're called."; }
                            Card {
                            title: "Finishing a capture";
                            Row {
                                label: "Enter (and the ✓ button) does";
                                sub: "Copy, Save, Pin and Share link close the frozen screen; Esc keeps it for Restore";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "Copy", value: 0 }, { label: "Save", value: 1 }, { label: "Copy + save", value: 2 }, { label: "Link", value: 3 }];
                                    value: SS.enter-does;
                                    picked(v) => { SS.set("enter_does", v == 1 ? "save" : v == 2 ? "copysave" : v == 3 ? "link" : "copy"); }
                                }
                            }
                            Row {
                                label: "Always copy the picture";
                                sub: "also when you save - paste it anywhere right after";
                                Switch { y: (parent.height - self.height) / 2; on: SS.always-copy; toggled(v) => { SS.set("always_copy", v ? "1" : "0"); } }
                            }
                            Row {
                                label: "Always fit Discord's 10 MB limit";
                                sub: "bigger pictures get smaller (lossless first, then JPEG) - no \"file too large\"";
                                Switch { y: (parent.height - self.height) / 2; on: SS.fits-discord; toggled(v) => { SS.set("fits_discord", v ? "1" : "0"); } }
                            }
                            Row {
                                label: "Camera sound";
                                sub: "a shutter sound when a picture is copied or saved";
                                Switch { y: (parent.height - self.height) / 2; on: SS.sounds; toggled(v) => { SS.set("sounds", v ? "1" : "0"); } }
                            }
                        }
Card {
                            title: "Saving";
                            Row {
                                label: "Save folder";
                                sub: SS.save-dir;
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Change"; clicked => { SS.act("pick-folder"); } }
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Open"; clicked => { SS.act("open-folder"); } }
                            }
                            Row {
                                label: "File name";
                                sub: "{yyyy} {MM} {dd} {HH} {mm} {ss}, {app} = the app or game (\"Lasso\" when unknown) - now: " + SS.name-example;
                                Rectangle {
                                    width: 260px;
                                    height: 32px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: T.r-btn;
                                    background: T.bg;
                                    border-width: 1px;
                                    border-color: ti.has-focus ? T.accent : T.line;
                                    ti := TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        vertical-alignment: center;
                                        text: SS.name-pattern;
                                        color: T.text;
                                        font-size: 13px;
                                        single-line: true;
                                        edited => { SS.set("name_pattern", self.text); }
                                    }
                                }
                            }
                            Row {
                                label: "Format";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "PNG", value: 0 }, { label: "JPG", value: 1 }, { label: "WebP", value: 2 }];
                                    value: SS.format;
                                    picked(v) => { SS.set("format", v == 1 ? "jpg" : v == 2 ? "webp" : "png"); }
                                }
                            }
                            if SS.echo-dir != "": Row {
                                label: "Also show in Echo";
                                sub: "a copy of every picture you save goes to Echo's Screenshots page (" + SS.echo-dir + ")";
                                Switch { y: (parent.height - self.height) / 2; on: SS.echo-shots; toggled(v) => { SS.set("echo_shots", v ? "1" : "0"); } }
                            }
                        }
                        }
                    }
                    library-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "library keep last captures days what goes in used every nothing game games steam screenshots folder folders xbox nvidia medal launcher"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Library"; sub: "Your last captures, kept on this PC."; }
                            Card {
                            title: "Keeping captures";
                            Row {
                                label: "Keep the last";
                                val: round(SS.keep-count) + " captures";
                                Slider { y: (parent.height - self.height) / 2; lo: 20; hi: 2000; step: 10; value: SS.keep-count; moved(v) => { SS.set("keep_count", round(v)); } }
                            }
                            Row {
                                label: "Keep for";
                                val: round(SS.keep-days) + " days";
                                Slider { y: (parent.height - self.height) / 2; lo: 7; hi: 365; step: 1; value: SS.keep-days; moved(v) => { SS.set("keep_days", round(v)); } }
                            }
                            Row {
                                label: "What goes in";
                                sub: "used = copied, saved, pinned or shared. Esc still brings the last one back (tray); Shift+Esc throws it away";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "Used ones", value: 0 }, { label: "Every capture", value: 1 }, { label: "Nothing", value: 2 }];
                                    value: SS.library-keep;
                                    picked(v) => { SS.set("library_keep", v == 1 ? "all" : v == 2 ? "none" : "used"); }
                                }
                            }
                            Note { text: SS.folder-note; }
                        }
Card {
                            title: "Game screenshots";
                            Row {
                                label: "Steam screenshots";
                                sub: SS.steam-note;
                                Switch { y: (parent.height - self.height) / 2; on: SS.steam-shots; toggled(v) => { SS.set("steam_shots", v ? "1" : "0"); } }
                            }
                            for d[i] in SS.game-dirs: Row {
                                label: "Added folder";
                                sub: d;
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Remove"; clicked => { SS.act("game-dir-remove:" + i); } }
                            }
                            Row {
                                label: "Other launchers";
                                sub: "Xbox Game Bar, NVIDIA, Medal... - add the folder they save screenshots in";
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Add a folder"; clicked => { SS.act("game-dir-add"); } }
                            }
                            Note { text: "They show up in the Library (by game) and the tray's latest pictures. Lasso only shows them - nothing is copied or moved."; }
                        }
                        }
                        }
                    }
                    share-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "share link links sonela account sign in email echo cloud private info view once expire expiry copy picture"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Share links"; sub: "sonela.app/s/... links for your screenshots."; }
                            Card {
                            title: "Your links";
                            has-switch: true;
                            on: SS.share-on;
                            toggled(v) => { SS.set("share_on", v ? "1" : "0"); }
                            if !SS.share-on: Note { text: "Off: the Share link button copies the picture instead. On: Ctrl+L puts a sonela.app/s/... link on the clipboard - no account needed."; }
                            if SS.share-on && SS.share-email == "": Note { text: "No account needed - links work right away."; }
                            // how long links last first: only "Forever" needs an account, so only then the sign-in shows (22 Nov
                            // 2026, the user: "it isn't clear that you only need to sign in for permanent links")
                            if SS.share-on: Row {
                                label: "Links last";
                                Seg {
                                    compact: true;
                                    opts: [{ label: "1 day", value: 1 }, { label: "7 days", value: 7 }, { label: "30 days", value: 30 }, { label: "1 year", value: 365 }, { label: "Forever", value: 0 }];
                                    value: SS.link-expiry;
                                    picked(v) => { SS.set("link_expiry", v); }
                                }
                            }
                            if SS.share-on && SS.share-email != "": Row {
                                label: "Signed in as " + SS.share-email;
                                sub: "links can last forever";
                                Btn { y: (parent.height - self.height) / 2; small: true; text: "Sign out"; enabled: !SS.share-busy; clicked => { SS.act("share-out"); } }
                            }
                            if SS.share-on && SS.share-email == "" && (SS.link-expiry == 0 || SS.share-code-step): Note {
                                text: "Forever needs a free Echo Cloud account: your email and a 6-digit code, no password. Until you sign in, links last 1 year.";
                            }
                            if SS.share-on && SS.share-email == "" && (SS.link-expiry == 0 || SS.share-code-step): Row {
                                label: SS.share-code-step ? "The 6-digit code from the email" : "Your email";
                                Rectangle {
                                    width: 220px;
                                    height: 32px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: T.r-btn;
                                    background: T.bg;
                                    border-width: 1px;
                                    border-color: sin.has-focus ? T.accent : T.line;
                                    if SS.share-input == "": Text {
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                        text: SS.share-code-step ? "6-digit code" : "your email address";
                                        color: T.muted;
                                        font-size: 13px;
                                    }
                                    sin := TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        vertical-alignment: center;
                                        color: T.text;
                                        font-size: 13px;
                                        single-line: true;
                                        text <=> SS.share-input;
                                        accepted => { SS.act((SS.share-code-step ? "share-code:" : "share-send:") + self.text); }
                                    }
                                }
                                Btn {
                                    y: (parent.height - self.height) / 2;
                                    small: true;
                                    primary: true;
                                    enabled: !SS.share-busy;
                                    text: SS.share-code-step ? "Sign in" : "Send code";
                                    clicked => { SS.act((SS.share-code-step ? "share-code:" : "share-send:") + sin.text); }
                                }
                            }
                            if SS.share-on && SS.share-msg != "": Text { text: SS.share-msg; color: T.muted; font-size: 12.5px; wrap: word-wrap; }
                            if SS.share-on: Row {
                                label: "Look for private info before sharing";
                                sub: "emails, phone numbers, keys: Lasso asks before the upload";
                                Switch { y: (parent.height - self.height) / 2; on: SS.share-check; toggled(v) => { SS.set("share_check", v ? "1" : "0"); } }
                            }
                            // Windows copies only the link (no picture + link on one clipboard there): no row
                            if SS.share-on && !SS.win: Row {
                                label: "Copy the picture too";
                                sub: "chat apps paste the picture, text boxes the link";
                                Switch { y: (parent.height - self.height) / 2; on: SS.share-both; toggled(v) => { SS.set("share_copy", v ? "both" : "link"); } }
                            }
                            if SS.share-on: Row {
                                label: "View-once links";
                                sub: "the picture is deleted after the first view";
                                Switch { y: (parent.height - self.height) / 2; on: SS.share-once; toggled(v) => { SS.set("share_once", v ? "1" : "0"); } }
                            }
                        }
                        }
                    }
                    appearance-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "appearance theme themes look colour color dark light teal violet coral ocean seasonal custom match system accent background"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Appearance"; sub: "Pick a look - the window and the bars on the frozen screen follow it."; }
                            Card {
                            title: "Look";
                            // Echo's / Aimdot's theme cards (21 Nov 2026); the bars on the frozen screen follow too
                            VerticalLayout {
                                padding-top: 6px;
                                ThemeGrid { cards: SS.theme-cards; picked(id) => { SS.set("theme", id); } }
                            }
                            Note { text: SS.theme-id == "system" ? "Match system: Light when your desktop uses a light theme, else Teal. The bars on the frozen screen use the theme too." : "Teal is Lasso's own look. Seasonal themes are near the end; Custom lets you pick your own colours. The bars on the frozen screen use the theme too."; }
                            if SS.theme-id == "custom": VerticalLayout {
                                spacing: 8px;
                                Row {
                                    label: "Custom accent";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for a in ["#14a38b", "#7c5cff", "#2fa8e0", "#2fbf86", "#e03232", "#e0609e", "#e0a93a", "#8fcf3c", "#8a96a8", "#ef6a4c"]: Swatch { hexv: a; on: SS.ui-accent == a; picked => { SS.set("ui_accent", a); } }
                                    }
                                }
                                Row {
                                    label: "Custom background";
                                    sub: "dark ones are kept dark enough to read; a light one gives light windows and bars";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for b in ["#0d0d10", "#0b0e12", "#100d0b", "#0b100e", "#100c0f", "#08080f", "#0d1015", "#1a1a1f", "#f4f4f7", "#f6f2ea"]: Swatch { hexv: b; on: SS.ui-bg == b; picked => { SS.set("ui_bg", b); } }
                                    }
                                }
                            }
                        }
                        }
                    }
                    start-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "start with my pc computer login autostart boot tray"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Start"; sub: "What happens when you turn on your PC."; }
                            Card {
                            Row {
                                label: "Start Lasso with your PC";
                                sub: "it waits in the tray (small, nothing runs until you capture)";
                                Switch { y: (parent.height - self.height) / 2; on: SS.autostart; toggled(v) => { SS.set("autostart", v ? "1" : "0"); } }
                            }
                        }
                        }
                    }
                    updates-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "updates update new version check channel beta dev stable upgrade"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "Updates"; sub: "You have Lasso " + SS.version + ". It keeps itself up to date."; }
                            Card {
                            Row {
                                label: SS.upd-available ? "Lasso " + SS.upd-version + " is out" : "Lasso updates";
                                sub: SS.upd-status;
                                if SS.upd-can-check: Btn {
                                    y: (parent.height - self.height) / 2;
                                    small: true;
                                    text: "Check for updates";
                                    enabled: !SS.upd-busy;
                                    clicked => { SS.act("upd-check"); }
                                }
                                if SS.upd-available: Btn {
                                    y: (parent.height - self.height) / 2;
                                    small: true;
                                    primary: true;
                                    text: SS.upd-button;
                                    enabled: !SS.upd-busy;
                                    clicked => { SS.act("upd-install"); }
                                }
                            }
                            if SS.upd-available && SS.upd-notes != "": Note { text: "What's new: " + SS.upd-notes; }
                            if SS.upd-can-check: Row {
                                label: "Update channel";
                                sub: SS.upd-channel == 1 ? "Beta - new versions a little earlier than everyone else."
                                    : SS.upd-channel == 2 ? "Dev - test builds for testers."
                                    : "Stable - the normal Lasso.";
                                Seg {
                                    y: (parent.height - self.height) / 2;
                                    opts: [{ label: "Stable", value: 0 }, { label: "Beta", value: 1 }, { label: "Dev", value: 2 }];
                                    value: SS.upd-asking-code ? 2 : SS.upd-channel;
                                    picked(v) => {
                                        SS.upd-code-msg = "";
                                        if (v == 2) {
                                            SS.upd-asking-code = SS.upd-channel != 2;
                                        } else {
                                            SS.upd-asking-code = false;
                                            if (v != SS.upd-channel) { SS.upd-channel = v; SS.act("upd-channel:" + v); }
                                        }
                                    }
                                }
                            }
                            if SS.upd-can-check && SS.upd-asking-code: Row {
                                label: "Dev code";
                                sub: SS.upd-code-msg != "" ? SS.upd-code-msg : "Dev is for testers - type the code you got from the developer.";
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 150px;
                                        height: 32px;
                                        border-radius: T.r-small;
                                        border-width: 1px;
                                        border-color: devcode.has-focus ? T.accent : T.line;
                                        background: T.bg;
                                        devcode := TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            color: T.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accepted => { if (!SS.upd-code-busy && self.text != "") { SS.upd-code-busy = true; SS.act("upd-code:" + self.text); } }
                                        }
                                    }
                                    Btn {
                                        y: (parent.height - self.height) / 2;
                                        small: true;
                                        primary: true;
                                        text: SS.upd-code-busy ? "Checking…" : "OK";
                                        enabled: !SS.upd-code-busy;
                                        clicked => { if (devcode.text != "") { SS.upd-code-busy = true; SS.act("upd-code:" + devcode.text); } }
                                    }
                                }
                            }
                            if SS.upd-can-check: Note { text: "Going back to Stable: you keep the version you have until Stable gets a newer one."; }
                            Note { text: "Lasso checks sonela.app every few hours. The check sends only Lasso's version and your system type (Windows or Linux) - no ID, nothing about you."; }
                        }
                        }
                    }
                    about-s := VerticalLayout {
                        if Find.q == "" || Find.matches(Find.q, "about version help privacy count daily numbers tray quit log"): VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 40px;
                            PageTitle { title: "About"; sub: "Help and privacy."; }
                            HorizontalLayout {
                            spacing: 14px;
                            LogoMark { width: 56px; height: 56px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: "Sonela Lasso"; font-size: 22px; font-weight: 700; color: T.text; }
                                Text { text: "Version " + SS.version + " · sonela.app/lasso"; font-size: 13px; color: T.muted; }
                                Text {
                                    text: SS.upd-available ? "Lasso " + SS.upd-version + " is out - see Updates" : "Updates";
                                    font-size: 13px;
                                    color: T.accent;
                                    TouchArea { mouse-cursor: pointer; clicked => { Find.q = ""; root.go("updates"); } }
                                }
                            }
                        }
Card {
                            title: "Help";
                            Note { text: "Take a screenshot: click the tray icon and Capture area (or press your hotkey), drag a box, draw, then Enter. The tray icon also shows your latest captures: click one to copy it. Esc closes at once - the tray menu's \"Restore last capture\" brings it back. Press ? on the frozen screen for every key."; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Btn { small: true; text: "Open the log folder"; clicked => { SS.act("open-log"); } }
                                Btn { small: true; text: "Capture now"; primary: true; clicked => { SS.act("capture"); } }
                            }
                        }
Card {
                            title: "Privacy";
                            Row {
                                label: "Count me in the daily numbers";
                                sub: "once a day Lasso tells sonela.app it's in use: its version and Windows or Linux - no ID, nothing else";
                                Switch { y: (parent.height - self.height) / 2; on: SS.usage-ping; toggled(v) => { SS.set("usage_ping", v ? "1" : "0"); } }
                            }
                        }
                        }
                    }
                    if Find.q != "" && !Find.matches(Find.q, "capture timer delay pointer mouse full screenshot monitor all magnifier zoom buttons bar under the box pin save copy link done thumbnail corner editing last tool start select saved picture replace copy keys keyboard shortcut shortcuts editor frozen screen reset default change tool undo redo copy save global hotkeys hotkey keys print screen capture area full window repeat restore delete last kde shortcuts enter done copy save link always copy fits discord 10 mb file too large save folder file name pattern format png jpg jpeg webp echo screenshots library keep last captures days what goes in used every nothing game games steam folder folders xbox nvidia medal launcher tools you see hide strip share link links sonela account sign in email echo cloud private info view once expire expiry copy picture appearance theme themes look colour color dark light teal violet coral ocean seasonal custom match system accent background start with my pc computer login autostart boot sounds sound camera shutter click chime tray about version help updates update new check upgrade channel beta dev stable privacy count daily numbers tray quit log"): Note { text: "Nothing found. Try another word, like \"theme\", \"hotkey\" or \"folder\"."; }
                    // room so the last section can scroll to the top
                    Rectangle { height: max(0px, sv.visible-height - about-s.preferred-height - 40px); }
                }
            }
        }
    }
}


