{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lasso",
  "mainBinaryName": "lasso",
  "version": "0.1.0",
  "identifier": "app.sonela.lasso",
  "build": {},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../assets/icons/lasso-256.png", "../../assets/icons/lasso.ico"],
    "publisher": "Resister0",
    "copyright": "© 2026 Resister0",
    "category": "Utility",
    "shortDescription": "Lasso - screenshots",
    "longDescription": "Lasso freezes the screen in a blink, so you can mark up a screenshot with every tool right there.",
    "licenseFile": "notice.txt",
    "resources": {
      "../../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "hooks.nsh",
        "installerIcon": "../../assets/icons/lasso.ico"
      }
    }
  }
}
